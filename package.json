{
  "name": "pedidos-a-preparar-sql",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "test": "node --test tests/*.test.mjs",
    "check:node": "node --check electron/main.cjs && node --check electron/repository.cjs && node --check electron/importers.cjs && node --check electron/config.cjs && node --check electron/scanner.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "mssql": "^11.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^6.2.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "ar.szconsultores.pedidosapreparar.sql",
    "productName": "Pedidos a Preparar",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "src/domain.js"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
